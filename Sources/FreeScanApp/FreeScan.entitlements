<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox ON with USB access. On macOS Sonoma+ (the V500 dev machine is Sequoia),
	     com.apple.security.device.usb is what lets a sandboxed app see a USB scanner via
	     ImageCaptureCore. If the scanner is not visible at runtime, the Step 0 diagnostic
	     (FreeScanDiag, an unsandboxed executable) will still see it; the documented fallback
	     is to set app-sandbox to false for direct distribution. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
